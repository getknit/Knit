<?xml version="1.0" encoding="utf-8"?>
<!--
    The direct-file-transfer mark: a page with a signal breaking off its cut corner.

    The single source of the glyph. Compose reads it through `ui/icons/KnitIcons.DirectTransfer`, and the
    notification uses it directly as a status-bar icon, so the overflow item, the chat-list preview and the
    heads-up cannot drift apart. Black paint throughout — every consumer tints it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The page, bottom-left, its top-right corner cut away as a fold. -->
    <path
        android:fillColor="#000000"
        android:pathData="M2,8 L9,8 L12,11 L12,22 L2,22 Z" />

    <!-- Two quarter-arcs centred on that corner, so the signal leaves the page rather than floating beside it. -->
    <path
        android:pathData="M12,6.5 A4.5,4.5 0 0 1 16.5,11"
        android:strokeColor="#000000"
        android:strokeLineCap="round"
        android:strokeWidth="1.9" />
    <path
        android:pathData="M12,2.5 A8.5,8.5 0 0 1 20.5,11"
        android:strokeColor="#000000"
        android:strokeLineCap="round"
        android:strokeWidth="1.9" />
</vector>
